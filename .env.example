# ─────────────────────────────────────────────────────────────────────────────
# Nimly Transcoder — configuración
# Copia este archivo a `.env` y llena los valores.  NADA de esto va a git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres ────────────────────────────────────────────────────────────────
# El worker hace LISTEN sobre una conexión directa a Postgres (puerto 5432).
#   Server (docker, red interna de Supabase):
#     DATABASE_URL=postgres://postgres:TU_PASS@db:5432/postgres
#   Test en tu Mac (necesitas alcanzar el 5432; ver README → "Test en Mac"):
#     DATABASE_URL=postgres://postgres:TU_PASS@127.0.0.1:5432/postgres   (túnel SSH)
DATABASE_URL=postgres://postgres:PASS@db:5432/postgres

# ── Supabase (API interna que usan worker + API para hablar con Storage) ─────
#   Server:  http://kong:8000      (nada sale por Cloudflare)
#   Mac:     https://supabase.platosmart.com
SUPABASE_URL=http://kong:8000

# URL PÚBLICA de Supabase — SOLO se usa para construir los signed URLs de los
# segmentos que van dentro del playlist que consume el teléfono.
#   Server:  https://supabase.platosmart.com
#   Mac:     (déjalo vacío -> usa SUPABASE_URL)
PUBLIC_SUPABASE_URL=https://supabase.platosmart.com

# service_role key del .env de Supabase (bypassa RLS). Baja/sube al bucket privado.
SERVICE_ROLE_KEY=

# JWT secret del .env de Supabase (JWT_SECRET). Se usa SOLO para verificar
# (HS256 + exp, sin red) los access tokens de usuario que llegan a la Media API.
SUPABASE_JWT_SECRET=

# ── Buckets ─────────────────────────────────────────────────────────────────
SOURCE_BUCKET=media
HLS_BUCKET=media-hls

# ── Media API ───────────────────────────────────────────────────────────────
MEDIA_API_PORT=8787
# TTL de los signed URLs de segmentos dentro del playlist (segundos). 21600 = 6h.
SIGNED_URL_TTL=21600
# Si true, la API hace stream de cada .ts desde el bucket privado (solo verifica
# firma+exp del JWT, sin BD). Recomendado: false (los sirve Supabase directo).
SEGMENT_PROXY=false

# ── ffmpeg / rendición ──────────────────────────────────────────────────────
TARGET_HEIGHT=720
VIDEO_BITRATE=2M
AUDIO_BITRATE=96k
X264_PRESET=veryfast
X264_CRF=23
HLS_SEGMENT_SECONDS=4

# ── Worker ──────────────────────────────────────────────────────────────────
MAX_ATTEMPTS=3
POLL_MS=15000
# Re-toma jobs 'processing' colgados hace más de N minutos.
STALE_PROCESSING_MINUTES=15
# Directorio temporal de trabajo (en docker es un tmpfs).
WORK_DIR=/tmp/work
LOG_LEVEL=info

# ── docker-compose ──────────────────────────────────────────────────────────
# Nombre real de la red docker externa de Supabase.
#   Confírmalo en el server:  docker network ls | grep supabase
SUPABASE_NETWORK=supabase_default

# ── Cloudflare Tunnel ───────────────────────────────────────────────────────
# Token del tunnel para el cloudflared de este stack. Puede ser el mismo token
# del cloudflared de Supabase (réplica del mismo tunnel) o el de un tunnel nuevo.
CLOUDFLARE_TUNNEL_TOKEN=
